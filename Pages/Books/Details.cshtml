@page
@model Campean_Anca_Lusia_Lab2.Pages.BookPages.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Book Details</h1>
<hr />

<dl class="row">
    <dt class="col-sm-2">Titlu</dt>
    <dd class="col-sm-10">@Model.Book.Title</dd>

    <dt class="col-sm-2">Autor</dt>
    <dd class="col-sm-10">
        @(Model.Book.Author?.FirstName)
        @(Model.Book.Author?.LastName)
    </dd>

    <dt class="col-sm-2">Preț</dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Book.Price)
    </dd>

    <dt class="col-sm-2">Data publicării</dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Book.PublishingDate)
    </dd>

    <dt class="col-sm-2">Editură</dt>
    <dd class="col-sm-10">
        @(Model.Book.Publisher?.PublisherName)
    </dd>

    <dt class="col-sm-2">Categorii</dt>
    <dd class="col-sm-10">
        @if (Model.Book.BookCategories != null &&
             Model.Book.BookCategories.Any())
        {
            foreach (var category in Model.Book.BookCategories)
            {
                <div>@(category.Category?.CategoryName)</div>
            }
        }
        else
        {
            <span>Nicio categorie atribuită</span>
        }
    </dd>
</dl>

<div>
    <a asp-page="/Books/Edit"
       asp-route-id="@Model.Book.ID">Edit</a> |
    <a asp-page="/Books/Index">Back to List</a>
</div>