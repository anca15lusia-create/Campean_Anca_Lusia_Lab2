@page
@model Campean_Anca_Lusia_Lab2.Pages.BookPages.EditModel

@{
    ViewData["Title"] = "Edit Book";
}

<h1>Edit Book</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <input type="hidden" asp-for="Book.ID" />

            <div class="mb-3">
                <label asp-for="Book.Title" class="form-label"></label>
                <input asp-for="Book.Title" class="form-control" />
                <span asp-validation-for="Book.Title"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Book.AuthorID" class="form-label">Autor</label>
                <select asp-for="Book.AuthorID"
                        asp-items="Model.AuthorOptions"
                        class="form-select">
                    <option value="">Alege autorul</option>
                </select>
                <span asp-validation-for="Book.AuthorID"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Book.Price" class="form-label"></label>
                <input asp-for="Book.Price" class="form-control" />
                <span asp-validation-for="Book.Price"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Book.PublishingDate" class="form-label"></label>
                <input asp-for="Book.PublishingDate" class="form-control" />
                <span asp-validation-for="Book.PublishingDate"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Book.PublisherID" class="form-label">Editură</label>
                <select asp-for="Book.PublisherID"
                        asp-items="Model.PublisherOptions"
                        class="form-select">
                    <option value="">Alege editura</option>
                </select>
                <span asp-validation-for="Book.PublisherID"
                      class="text-danger"></span>
            </div>

            <input type="submit" value="Save" class="btn btn-primary" />
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}