@page "/"
@model Campean_Anca_Lusia_Lab2.Pages.BookPages.IndexModel

@{
    ViewData["Title"] = "Books";
}

<h1>Books</h1>

<p>
    <a asp-page="/Books/Create">Create New</a>
</p>

<form method="get" class="mb-3">
    <label asp-for="AuthorID">Autor</label>

    <select asp-for="AuthorID"
            asp-items="Model.AuthorOptions"
            class="form-select">
        <option value="">Toți autorii</option>
    </select>

    <button type="submit" class="btn btn-primary mt-2">
        Filtrează
    </button>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Titlu</th>
            <th>Autor</th>
            <th>Preț</th>
            <th>Data publicării</th>
            <th>Editură</th>
            <th>Categorii</th>
            <th>Acțiuni</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.BookD.Books)
        {
            string selectedRow =
                item.ID == Model.BookID ? "table-success" : "";

            <tr class="@selectedRow">
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>

                <td>
                    @if (item.Author != null)
                    {
                        @($"{item.Author.FirstName} {item.Author.LastName}")
                    }
                    else
                    {
                        <span>Autor neatribuit</span>
                    }
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Price)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.PublishingDate)
                </td>

                <td>
                    @(item.Publisher?.PublisherName)
                </td>

                <td>
                    @if (item.BookCategories != null)
                    {
                        foreach (var category in item.BookCategories)
                        {
                            if (category.Category != null)
                            {
                                <div>
                                    @category.Category.ID
                                    @category.Category.CategoryName
                                </div>
                            }
                        }
                    }
                </td>

                <td>
                    <a asp-page="/Books/Index"
                       asp-route-id="@item.ID"
                       asp-route-AuthorID="@Model.AuthorID">Select</a> |

                    <a asp-page="/Books/Edit"
                       asp-route-id="@item.ID">Edit</a> |

                    <a asp-page="/Books/Details"
                       asp-route-id="@item.ID">Details</a> |

                    <a asp-page="/Books/Delete"
                       asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>