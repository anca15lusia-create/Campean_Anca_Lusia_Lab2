@page
@model Campean_Anca_Lusia_Lab2.Pages.BookPages.IndexModel

@{
    ViewData["Title"] = "Books";
}

<h1>Books</h1>

<p>
    <a asp-page="./Create">Create New</a>
</p>

<form method="get" class="mb-3">
    <label asp-for="AuthorID">Autor</label>

    <select asp-for="AuthorID"
            asp-items="Model.AuthorOptions"
            class="form-select">
        <option value="">Toți autorii</option>
    </select>

    <button type="submit" class="btn btn-primary mt-2">
        Filtrează
    </button>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Titlu</th>
            <th>Autor</th>
            <th>Preț</th>
            <th>Data publicării</th>
            <th>Editură</th>
            <th>Acțiuni</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Book)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Title)</td>
                <td>
                    @if (item.Author != null)
                    {
                        @($"{item.Author.FirstName} {item.Author.LastName}")
                    }
                    else
                    {
                        <span>Autor neatribuit</span>
                    }
                </td>
                <td>@Html.DisplayFor(modelItem => item.Price)</td>
                <td>
                    @Html.DisplayFor(modelItem => item.PublishingDate)
                </td>
                <td>@(item.Publisher?.PublisherName)</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>