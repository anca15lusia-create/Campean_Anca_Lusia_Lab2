@page
@model Campean_Anca_Lusia_Lab2.Pages.Publisher.DeleteModel

@{
    ViewData["Title"] = "Delete Publisher";
}

<h1>Delete</h1>

<h3>Sigur vrei să ștergi această editură?</h3>

<div>
    <h4>Publisher</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            Publisher Name
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Publisher.PublisherName)
        </dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Publisher.ID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>